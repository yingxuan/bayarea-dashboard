# API Keys for BayArea Dashboard
# Copy this file to .env and fill in your API keys
# IMPORTANT: Never commit .env or .env.local files (they are in .gitignore)

# NewsAPI.org - Get free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Finnhub API - Get free key at https://finnhub.io/ (REQUIRED for stock quotes feature)
# Server-side only - never exposed to frontend bundle
FINNHUB_API_KEY=your_finnhub_key_here

# Yelp Fusion API - Get key at https://www.yelp.com/developers
YELP_API_KEY=your_yelp_api_key_here

# TMDB API - Get key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Google Custom Search Engine (optional)
GOOGLE_CSE_API_KEY=your_google_cse_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# JWT Secret for authentication (REQUIRED for auth feature)
# Must be at least 32 characters
JWT_SECRET=your_jwt_secret_at_least_32_characters_here

# Cross-origin auth (frontend on manus.space, API on vercel.app)
# Set COOKIE_SAME_SITE_NONE=1 in Vercel so cookies are sent on cross-origin requests.
# Then users must log in again to get new cookies.
# COOKIE_SAME_SITE_NONE=1

# Postgres (Vercel production only – required for persistent auth)
# Add Neon Postgres from Vercel Marketplace; it injects POSTGRES_URL or DATABASE_URL.
# Leave unset locally to use SQLite (cache.db).
# POSTGRES_URL=postgresql://...
# DATABASE_URL=postgresql://...

# Password reset email – SMTP (no public domain needed, e.g. Gmail)
# Gmail: enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=湾区仪表盘 <your@gmail.com>

# Reset link base URL (used in email)
FRONTEND_URL=https://yoursite.com
